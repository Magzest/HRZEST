[flake8]
# This codebase's own established style favors long, single-line prose
# comments/docstrings and long f-string log/security-event messages over
# hard-wrapping them -- 120 was already a deliberate departure from
# pycodestyle's 79-col default for that reason. Raised further to 160,
# which is where the actual distribution of "just a bit long" lines from
# that same style clears (334 lines were 121-140 chars, 91 more were
# 141-160) -- genuinely oversized lines above that (161+) were fixed
# directly rather than raising the ceiling to cover them too.
max-line-length = 160
# wsgi.py's import order is deliberate, not an oversight — extensions.py
# must be imported before blueprints/*, which must be imported before
# app.py (see the comments in wsgi.py explaining why). E402 exists to catch
# accidental mid-file imports, not to force this file into a shape that
# would break its actual startup sequencing.
#
# app.py, tests/conftest.py, and run_dev.py each call load_dotenv()/set
# os.environ[...] (SECRET_KEY, ENCRYPTION_KEY, APP_ENV, DB_*) before
# importing extensions/database/utils modules that read those variables at
# import time (several now fail hard when they're missing, e.g.
# extensions.py's check_secret_key_configured()) -- moving the imports
# above that setup would break startup, not just reorder cosmetics.
per-file-ignores =
    wsgi.py:E402
    app.py:E402
    tests/conftest.py:E402
    run_dev.py:E402
