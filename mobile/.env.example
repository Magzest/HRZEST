# Copy this file to .env (local dev) or .env.production (release builds).
# Expo automatically inlines any EXPO_PUBLIC_* var into the JS bundle at
# build time — see src/config.js.
#
# Never commit real .env / .env.production files — they're already covered
# by the repo's root .gitignore (`.env` pattern).

# Production API origin. MUST be https:// — see src/config.js for why.
EXPO_PUBLIC_API_BASE_URL=https://yourdomain.com

# Optional. Crash reporting is a no-op until this is set (see src/utils/crashReporting.js).
# Get one from sentry.io -- Create Project -> React Native.
EXPO_PUBLIC_SENTRY_DSN=
